# --- Supabase ---
# Get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role key — server-only, bypasses RLS. Used by guest-checkout
# and order-confirmation reads. Never expose via NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Store configuration ---
# Sri Lankan mobile in international format, no + or leading zeros.
# Used by the WhatsApp quick-buy button on product pages.
# Leave unset to hide the button entirely.
NEXT_PUBLIC_STORE_WA_NUMBER=94771234567
